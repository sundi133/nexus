# Live vendor check (docs/LIVE-CHECK.md). Copy to live-check.env (git-ignored), fill in what you
# have, and leave the rest empty: unconfigured checks are skipped. No quotes around values.
# Use read-only credentials made for this, and delete them afterwards.

# ---- Microsoft Entra ID directory (app: User.Read.All, Group.Read.All, GroupMember.Read.All) ----
LIVE_ENTRA_TENANT_ID=
LIVE_ENTRA_CLIENT_ID=
LIVE_ENTRA_CLIENT_SECRET=

# ---- Google Workspace directory (service account with domain-wide delegation) ----
LIVE_GOOGLE_ADMIN_EMAIL=
LIVE_GOOGLE_KEY_FILE=
LIVE_GOOGLE_CUSTOMER_ID=

# ---- Active Directory / LDAP (read-only service account) ----
LIVE_LDAP_URL=
LIVE_LDAP_BIND_DN=
LIVE_LDAP_PASSWORD=
LIVE_LDAP_BASE_DN=
# active_directory (default), openldap or custom
LIVE_LDAP_PRESET=
LIVE_LDAP_START_TLS=
LIVE_LDAP_CA_FILE=
LIVE_LDAP_USER_FILTER=
LIVE_LDAP_GROUP_FILTER=
# true if the directory is on a private network (as NEXUS_ALLOW_PRIVATE_DIRECTORY on the server)
LIVE_ALLOW_PRIVATE_DIRECTORY=

# ---- Sign-in metadata (public; no secrets) ----
# e.g. https://login.microsoftonline.com/<tenant ID>/v2.0,https://acme.okta.com
LIVE_OIDC_ISSUERS=
# e.g. https://login.microsoftonline.com/<tenant ID>/federationmetadata/2007-06/federationmetadata.xml
LIVE_SAML_METADATA_URLS=

# ---- Intune (app: DeviceManagementManagedDevices.Read.All) ----
# Leave the three empty and set LIVE_INTUNE=true to reuse the Entra app above.
LIVE_INTUNE=
LIVE_INTUNE_TENANT_ID=
LIVE_INTUNE_CLIENT_ID=
LIVE_INTUNE_CLIENT_SECRET=

# ---- Jamf Pro (API client whose role has Read Computers) ----
LIVE_JAMF_URL=
LIVE_JAMF_CLIENT_ID=
LIVE_JAMF_CLIENT_SECRET=

# ---- On-call: run with --page (sends one [TEST] incident, then resolves it) ----
LIVE_PAGERDUTY_ROUTING_KEY=
LIVE_OPSGENIE_API_KEY=
# us (default) or eu
LIVE_OPSGENIE_REGION=

# ---- SIEM and archive: run with --send-events (delivers one test event) ----
# Data collection endpoint, e.g. https://nexus-dce-abcd.eastus-1.ingest.monitor.azure.com
LIVE_SENTINEL_ENDPOINT=
LIVE_SENTINEL_DCR_ID=
LIVE_SENTINEL_STREAM=
LIVE_SENTINEL_TENANT_ID=
LIVE_SENTINEL_CLIENT_ID=
LIVE_SENTINEL_CLIENT_SECRET=
# e.g. https://my-bucket.s3.eu-west-1.amazonaws.com
LIVE_S3_URL=
LIVE_S3_ACCESS_KEY_ID=
LIVE_S3_SECRET_ACCESS_KEY=
LIVE_S3_REGION=
LIVE_S3_PREFIX=
