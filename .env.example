# Copy to .env for local overrides. Defaults below match deploy/compose.
NEXUS_PORT=8080
NEXUS_DATABASE_URL=postgres://nexus_app:nexus_app@localhost:55432/nexus?sslmode=disable
NEXUS_DATABASE_OWNER_URL=postgres://nexus_owner:nexus_owner@localhost:55432/nexus?sslmode=disable
NEXUS_PUBLIC_URL=http://localhost:3100
NEXUS_ENV=dev
# Email (Mailpit locally: inbox at http://localhost:58025)
NEXUS_SMTP_URL=smtp://localhost:51025
NEXUS_MAIL_FROM="Votal Nexus <no-reply@nexus.local>"
# WebAuthn relying party: must match the host users see in the browser
NEXUS_RP_ID=localhost
# How phones reach the API (use your LAN IP when testing Nexus Mobile on a device)
NEXUS_API_PUBLIC_URL=http://localhost:8080
