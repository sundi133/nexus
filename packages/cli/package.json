{
  "name": "@nexus/cli",
  "version": "0.1.0",
  "private": true,
  "description": "nexus: the Votal Nexus command line (config as code, agents, alerts, audit)",
  "type": "module",
  "bin": { "nexus": "./dist/nexus.mjs" },
  "main": "./src/cli.ts",
  "exports": { ".": "./src/cli.ts" },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/nexus.mjs --banner:js='#!/usr/bin/env node'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nexus/api-client": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  }
}
