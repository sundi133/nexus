{
  "name": "@nexus/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --disable-warning=ExperimentalWarning src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts",
    "spec": "tsx src/cli/spec.ts > openapi.json",
    "reseal": "tsx --env-file-if-exists=../../.env src/cli/reseal.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@node-rs/argon2": "^2.2.1",
    "@peculiar/x509": "^2.1.0",
    "@simplewebauthn/server": "^14.0.2",
    "@xmldom/xmldom": "^0.9.12",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "nodemailer": "^10.0.10",
    "otpauth": "^9.5.2",
    "pg": "^8.23.0",
    "reflect-metadata": "0.2.2",
    "uuidv7": "^1.2.1",
    "xml-crypto": "^6.3.1",
    "xpath": "^0.0.34",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@node-saml/node-saml": "^5.1.0",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "openid-client": "^6.8.8",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
