# Copy to prod.env and fill in. Generate secrets with: openssl rand -base64 32
NEXUS_CONSOLE_HOST=nexus.example.com
NEXUS_API_HOST=api.nexus.example.com
NEXUS_OWNER_DB_PASSWORD=
NEXUS_APP_DB_PASSWORD=
# Seal keys: "<id>:<base64 32 bytes>", current first. Rotate by prepending a new id, then run reseal.
NEXUS_SEAL_KEYS=1:
NEXUS_SMTP_URL=smtps://user:password@smtp.example.com:465
NEXUS_MAIL_FROM="Votal Nexus <no-reply@nexus.example.com>"
NEXUS_METRICS_TOKEN=
# Who can create an organization: first (only yours, then closed), closed, or open (a hosted service)
NEXUS_SIGNUP=first
# true when your domain controllers are on a private network this server can reach (direct AD/LDAP sync)
NEXUS_ALLOW_PRIVATE_DIRECTORY=false
# Optional
NEXUS_AGENT_RELEASE_KEYS=
NEXUS_APNS_TEAM_ID=
NEXUS_APNS_KEY_ID=
NEXUS_APNS_KEY=
NEXUS_FCM_SERVICE_ACCOUNT=
