<!--
  Votal Nexus agent: Windows Installer package (WiX Toolset v5).

  Built by build-msi.ps1. Windows Installer copies the binary, registers and starts the
  service and locks down the state folder. When TOKEN is given, one step runs the agent to
  leave enroll.conf for the service to enroll with (its command line is kept out of the log).

    msiexec /i nexus-agent-x64.msi /qn SERVER=https://api.nexus.example.com TOKEN=nxe_...

  Intune, Group Policy and other deployment tools pass the same two properties.
  Uninstalling keeps C:\ProgramData\Nexus (the device key), so reinstalling
  resumes the same device, like `nexus-agent uninstall` without purge.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Votal Nexus agent"
           Manufacturer="Votal AI"
           Version="$(Version)"
           UpgradeCode="8772c628-68e5-49b8-9253-f95a15cd9980"
           Scope="perMachine"
           Compressed="yes">
    <SummaryInformation Description="Reports device security posture to Votal Nexus" />
    <!-- Newer builds replace older ones; the agent's own self-updates don't change what's registered. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of the Nexus agent is already installed."
                  AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />

    <!-- Enrollment, as passed on the msiexec command line. TOKEN is a secret: keep it out of logs. -->
    <Property Id="SERVER" Secure="yes" />
    <Property Id="TOKEN" Secure="yes" Hidden="yes" />
    <Launch Condition="Installed OR NOT TOKEN OR SERVER" Message="Pass SERVER=https://… together with TOKEN=…" />

    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://votal.ai" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Nexus">
        <Component Id="Agent">
          <File Id="AgentExe" Source="$(BinDir)\nexus-agent.exe" KeyPath="yes" />
          <!-- The self-updater keeps .previous / .failed copies and staging files next to the binary. -->
          <RemoveFile Id="UpdaterFiles" Name="*" On="uninstall" />
          <ServiceInstall Id="AgentService"
                          Name="NexusAgent"
                          DisplayName="Votal Nexus agent"
                          Description="Reports device security posture to Votal Nexus."
                          Type="ownProcess"
                          Start="auto"
                          ErrorControl="normal"
                          Account="LocalSystem"
                          Arguments="run --state-dir &quot;[CommonAppDataFolder]Nexus&quot;"
                          Vital="yes">
            <!-- Restart-on-failure is set by the agent itself each time the service starts (ensureRecovery),
                 including restarting after a clean exit (a self-update), which the MSI can't express.
                 Setting it here as well made Windows Installer fail with error 1939. -->
          </ServiceInstall>
          <!-- [CommonAppDataFolder]Nexus, not [STATEFOLDER]: that ends in a backslash, which would escape the closing quote. -->
          <ServiceControl Id="AgentServiceControl" Name="NexusAgent" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        </Component>
        <?ifdef OsqueryDir?>
        <!-- osquery, as osquery signed it (build-msi.ps1 -OsqueryDir). The agent finds it next to itself. -->
        <Directory Id="OSQUERYFOLDER" Name="osquery">
          <Component Id="Osquery">
            <File Id="OsquerydExe" Source="$(OsqueryDir)\osqueryd.exe" KeyPath="yes" />
            <File Id="OsqueryLicense" Source="$(OsqueryDir)\LICENSE-osquery.txt" />
          </Component>
        </Directory>
        <?endif?>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="STATEFOLDER" Name="Nexus">
        <!-- SYSTEM and Administrators only, not inherited: ProgramData is readable by every user by default,
             and this folder holds the device key and, briefly, the enrollment token. -->
        <Component Id="StateFolder" Guid="a4e150c9-22c1-4f17-98a4-98964ee0997c" Permanent="yes">
          <CreateFolder>
            <PermissionEx Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
          </CreateFolder>
        </Component>
        <!-- Only with TOKEN, enroll.conf is written by the WriteEnrollConfig step below (not IniFile:
             Windows Installer logs the values IniFile writes, which would put the token in verbose logs). -->
      </Directory>
    </StandardDirectory>

    <!-- With TOKEN: the agent writes enroll.conf (SYSTEM, into the locked-down state folder) before the service
         starts. HideTarget keeps the command line, and so the token, out of the installer's log. -->
    <CustomAction Id="WriteEnrollConfig" FileRef="AgentExe" Execute="deferred" Impersonate="no" Return="check" HideTarget="yes"
                  ExeCommand="write-enroll-config --state-dir &quot;[CommonAppDataFolder]Nexus&quot; --server &quot;[SERVER]&quot; --token &quot;[TOKEN]&quot;" />
    <InstallExecuteSequence>
      <Custom Action="WriteEnrollConfig" After="InstallFiles" Condition="TOKEN AND NOT REMOVE" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="Nexus agent">
      <ComponentRef Id="Agent" />
      <ComponentRef Id="StateFolder" />
      <?ifdef OsqueryDir?>
      <ComponentRef Id="Osquery" />
      <?endif?>
    </Feature>
  </Package>
</Wix>
